+private fun java.io.InputStream.readHead(limit: Int): ByteArray {
+    val buffer = ByteArray(limit)
+    var count = 0
+    while (count < limit) {
+        val read = read(buffer, count, limit - count)
+        if (read < 0) break
+        count += read
+    }
+    return if (count == limit) buffer else buffer.copyOf(count)
+}
